{
  "layout": {
    "type": "layout",
    "pages": [
      "general-page",
      "format-page",
      "routing-page",
      "alerts-page"
    ],
    "general-page": {
      "type": "page",
      "title": "Codex Usage",
      "sections": [
        "command-section",
        "backend-section",
        "refresh-section",
        "display-section",
        "consumption-section",
        "reactivation-options-section"
      ]
    },
    "format-page": {
      "type": "page",
      "title": "Formatierung",
      "sections": [
        "formatting-section",
        "display-target-section"
      ]
    },
    "alerts-page": {
      "type": "page",
      "title": "Warnungen",
      "sections": [
        "alerts-section"
      ]
    },
    "routing-page": {
      "type": "page",
      "title": "Routing und Credits",
      "sections": [
        "routing-section"
      ]
    },
    "command-section": {
      "type": "section",
      "title": "Datenquelle",
      "keys": [
        "command-path",
        "config-path"
      ]
    },
    "refresh-section": {
      "type": "section",
      "title": "Aktualisierung",
      "keys": [
        "auto-refresh",
        "poll-owner",
        "refresh-interval",
        "refresh-on-open"
      ]
    },
    "backend-section": {
      "type": "section",
      "title": "Abrufwege und Accounts",
      "keys": [
        "account-backends"
      ]
    },
    "display-section": {
      "type": "section",
      "title": "Leiste",
      "keys": [
        "account-panel-settings",
        "panel-account-separator",
        "panel-percent-source"
      ]
    },
    "consumption-section": {
      "type": "section",
      "title": "Verbrauchszeiträume",
      "keys": [
        "account-consumption-settings",
        "show-consumption-delta",
        "account-reset-display-settings"
      ]
    },
    "reactivation-options-section": {
      "type": "section",
      "title": "Reaktivierungsoptionen",
      "keys": [
        "show-reactivation-actions"
      ]
    },
    "formatting-section": {
      "type": "section",
      "title": "Hervorhebungen und Design:",
      "keys": [
        "account-percent-styles",
        "account-date-styles",
        "account-time-styles",
        "account-duration-styles"
      ]
    },
    "display-target-section": {
      "type": "section",
      "title": "Anzeige:",
      "keys": [
        "account-display-settings",
        "account-style-targets"
      ]
    },
    "percent-style-section": {
      "type": "section",
      "title": "Verbleibendes Tokenlimit in %",
      "keys": [
        "account-percent-styles"
      ]
    },
    "date-style-section": {
      "type": "section",
      "title": "OpenAI - Reset: Datum des Reset",
      "keys": [
        "account-date-styles"
      ]
    },
    "time-style-section": {
      "type": "section",
      "title": "OpenAI - Reset: Uhrzeit",
      "keys": [
        "account-time-styles"
      ]
    },
    "duration-style-section": {
      "type": "section",
      "title": "OpenAI - Reset: Restlaufzeit in Tagen bis Limitreset",
      "keys": [
        "account-duration-styles"
      ]
    },
    "style-target-section": {
      "type": "section",
      "title": "Anzeige:",
      "keys": [
        "account-display-settings",
        "account-style-targets"
      ]
    },
    "alerts-section": {
      "type": "section",
      "title": "Benachrichtigungen",
      "keys": [
        "account-alert-settings",
        "warning-threshold",
        "notify-warnings",
        "notify-errors"
      ]
    },
    "routing-section": {
      "type": "section",
      "title": "Bezahlte Nutzung",
      "keys": [
        "routing-global-paid-credits",
        "routing-credit-overrides"
      ]
    }
  },
  "command-path": {
    "type": "entry",
    "description": "Pfad zum codex-usage-Befehl",
    "tooltip": "Ein absoluter Pfad ist am zuverlässigsten. Bei 'codex-usage' wird zusätzlich ~/.local/bin geprüft.",
    "default": "codex-usage"
  },
  "config-path": {
    "type": "entry",
    "description": "Alternative config.toml",
    "tooltip": "Leer lassen, um den Standardpfad der CLI zu verwenden.",
    "default": ""
  },
  "auto-refresh": {
    "type": "switch",
    "description": "Werte automatisch frisch abrufen",
    "default": true
  },
  "poll-owner": {
    "type": "combobox",
    "description": "Regelmäßigen Abruf ausführen durch",
    "options": {
      "Automatisch": "auto",
      "Cinnamon-Applet": "applet",
      "systemd-User-Timer": "systemd"
    },
    "default": "auto"
  },
  "account-backends": {
    "type": "list",
    "description": "Abrufwege und Accounts · Profilordner wird automatisch angelegt, wenn er noch nicht vorhanden ist.",
    "tooltip": "Plus legt Account an. Minus löscht Account aus der Config, der Profilordner bleibt erhalten. Doppelklick oder Bearbeiten ändert Account-Optionen.",
    "columns": [
      {
        "id": "account",
        "title": "Account-ID",
        "type": "string"
      },
      {
        "id": "label",
        "title": "Label",
        "type": "string"
      },
      {
        "id": "auth-json",
        "title": "Auth JSON",
        "type": "file"
      },
      {
        "id": "profile-dir",
        "title": "Profilordner",
        "type": "file",
        "select-dir": true
      },
      {
        "id": "test-home",
        "title": "Test-Home",
        "type": "boolean",
        "tooltip": "Legt das Profil unter ~/.codex-test an, integriert auth.json und initialisiert Codex mit Dateispeicher.",
        "default": false
      },
      {
        "id": "browser",
        "title": "Browser",
        "type": "integer",
        "options": {
          "Firefox": 0,
          "Chromium": 1
        },
        "default": 0
      },
      {
        "id": "reactivation-browser",
        "title": "Reaktivierungsbrowser",
        "type": "integer",
        "options": {
          "Automatisch": 0,
          "Vivaldi": 1,
          "Chromium": 2,
          "Firefox": 3
        },
        "default": 0
      },
      {
        "id": "backend",
        "title": "Abrufweg",
        "type": "integer",
        "options": {
          "Bisheriger Direktabruf": 0,
          "Codex App Server": 1
        },
        "default": 0
      }
    ],
    "height": 180,
    "show-buttons": true,
    "hidden-buttons": [
      "up",
      "down"
    ],
    "default": []
  },
  "account-percent-styles": {
    "type": "list",
    "description": "Verbleibendes Tokenlimit in %",
    "columns": [
      {
        "id": "account",
        "title": "Account-ID",
        "type": "string"
      },
      {
        "id": "mode",
        "title": "Formatierungsmodus",
        "tooltip": "Immer, nur unter Schwelle, immer mit Alternativformat unter Schwelle oder aus.",
