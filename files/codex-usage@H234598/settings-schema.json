      {
        "id": "color",
        "title": "Über der Schwelle Schriftfarbe",
        "tooltip": "Theme übernimmt die Standardfarbe. Eine gewählte Farbe gilt unabhängig vom Hintergrund.",
        "type": "integer",
        "options": {
          "Theme": 0,
          "Schwarz": 1,
          "Weiß": 2,
          "Rot": 3,
          "Grün": 4,
          "Blau": 5,
          "Gelb": 6,
          "Grau": 7
        },
        "default": 0
      },
      {
        "id": "background",
        "title": "Über der Schwelle Hintergrund",
        "type": "integer",
        "options": {
          "Transparent": 0,
          "Dunkel": 1,
          "Hell": 2,
          "Rot": 3,
          "Grün": 4,
          "Blau": 5,
          "Gelb": 6
        }
      },
      {
        "id": "threshold",
        "title": "Schwelle %",
        "type": "integer",
        "min": 0,
        "max": 100,
        "default": 20
      },
      {
        "id": "below-font",
        "title": "Unter der Schwelle Schriftart",
        "type": "integer",
        "options": {
          "Theme": 0,
          "Sans": 1,
          "Serif": 2,
          "Monospace": 3
        },
        "default": 0
      },
      {
        "id": "below-size",
        "title": "Unter der Schwelle Größe",
        "type": "integer",
        "min": 0,
        "max": 48,
        "default": 0
      },
      {
        "id": "below-bold",
        "title": "Unter der Schwelle Fett",
        "type": "boolean",
        "default": true
      },
      {
        "id": "below-italic",
        "title": "Unter der Schwelle Kursiv",
        "type": "boolean",
        "default": false
      },
      {
        "id": "below-color",
        "title": "Unter der Schwelle Schriftfarbe",
        "type": "integer",
        "options": {
          "Theme": 0,
          "Schwarz": 1,
          "Weiß": 2,
          "Rot": 3,
          "Grün": 4,
          "Blau": 5,
          "Gelb": 6,
          "Grau": 7
        },
        "default": 3
      },
      {
        "id": "below-background",
        "title": "Unter der Schwelle Hintergrund",
        "type": "integer",
        "options": {
          "Transparent": 0,
          "Dunkel": 1,
          "Hell": 2,
          "Rot": 3,
          "Grün": 4,
          "Blau": 5,
          "Gelb": 6
        },
        "default": 0
      }
    ],
    "height": 180,
    "show-buttons": true,
    "hidden-buttons": ["+", "-", "up", "down"],
    "default": []
  },
