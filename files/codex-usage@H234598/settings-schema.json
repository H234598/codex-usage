        "options": {
          "Immer": 0,
          "Nur unter Schwelle": 1,
          "Immer, unter Schwelle anders": 2,
          "Aus": 3
        },
        "default": 0
      },
      {
        "id": "font",
        "title": "Über der Schwelle Schriftart",
        "type": "integer",
        "options": {
          "Theme": 0,
          "Sans": 1,
          "Serif": 2,
          "Monospace": 3
        }
      },
      {
        "id": "size",
        "title": "Über der Schwelle Größe",
        "tooltip": "0 übernimmt die Schriftgröße des Cinnamon-Themes.",
        "type": "integer",
        "min": 0,
        "max": 48,
        "default": 0
      },
      {
        "id": "bold",
        "title": "Über der Schwelle Fett",
        "type": "boolean",
        "default": false
      },
      {
        "id": "italic",
